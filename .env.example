# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
# For Prisma CLI (db push / migrate). Prefer Neon direct URL (non-pooler host).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# PRISMA_NEON=false


# OpenAI
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_KEY_HERE"

# App URL
NEXT_PUBLIC_APP_URL="https://www.faztino.com"


# Demo assistant
NEXT_PUBLIC_DEMO_BOT_ID="demo_site_assistant"

# Email (optional)
RESEND_API_KEY="re_YOUR_RESEND_KEY_HERE"
EMAIL_FROM="faztino <noreply@faztino.com>"

# Stripe — PRODUCTION KEYS (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_live_YOUR_LIVE_KEY_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_LIVE_KEY_HERE"
STRIPE_PRICE_STARTER="price_YOUR_STARTER_PRICE_ID"
STRIPE_PRICE_STARTER_YEARLY="price_YOUR_STARTER_YEARLY_PRICE_ID"
STRIPE_PRICE_PRO="price_YOUR_PRO_PRICE_ID"
STRIPE_PRICE_PRO_MONTHLY="price_YOUR_PRO_MONTHLY_PRICE_ID"
STRIPE_PRICE_PRO_YEARLY="price_YOUR_PRO_YEARLY_PRICE_ID"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# Paystack (Nigerian payments). Get keys at https://dashboard.paystack.com/#/settings/developers
# Leave empty to disable Paystack — Nigerian users will fall back to Stripe USD.
#PAYSTACK_SECRET_KEY=""
#NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Same value as PAYSTACK_SECRET_KEY (Paystack signs webhooks with your secret key).
# See https://paystack.com/docs/payments/webhooks/
#PAYSTACK_PRO_PLAN_CODE=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_live_YOUR_CLERK_SECRET_KEY"
# Default: no same-origin /__clerk proxy (browser → clerk.*.com). Only set =1 if configured in Clerk Dashboard.
# CLERK_FRONTEND_API_PROXY=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# Production hardening - REQUIRED in production
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN_HERE"
HEALTH_CHECK_SECRET="GENERATE_A_RANDOM_SECRET_HERE"
# Comma-separated list of allowed origins for widget embedding (leave empty to allow all)
# WIDGET_ALLOWED_ORIGINS="https://app.example.com,https://www.example.com"


# REQUIRED: Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY="YOUR_32_BYTE_BASE64_KEY_HERE"
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="YOUR_CRON_SECRET_HERE"

# Calendar sync (optional - configure if you need Google/Microsoft calendar integration)
#GOOGLE_CLIENT_ID=""
#GOOGLE_CLIENT_SECRET=""
#MICROSOFT_CLIENT_ID=""
#MICROSOFT_CLIENT_SECRET=""

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY_HERE"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY_HERE"
VAPID_SUBJECT="mailto:support@faztino.com"

# Inbound AI phone answering (Vapi + Twilio). Link Twilio in the Vapi dashboard once.
# Webhook URL: ${NEXT_PUBLIC_APP_URL}/api/vapi/webhook
#VAPI_API_KEY=""
#VAPI_WEBHOOK_SECRET=""
#TWILIO_ACCOUNT_SID=""
#TWILIO_AUTH_TOKEN=""
#VAPI_DEFAULT_VOICE_ID="jennifer-playht"
#VAPI_PHONE_AREA_CODE="415"

# Optional setup walkthrough video (YouTube/Loom). Shows "Watch setup (2 min)" on Integration.
#NEXT_PUBLIC_SETUP_VIDEO_URL="https://www.youtube.com/watch?v=..."

# Admin Access (optional - comma-separated Clerk user IDs)
#ADMIN_CLERK_USER_IDS=""

# Sentry (optional - for error tracking in production)
#SENTRY_DSN=""
#SENTRY_ORG=""
#SENTRY_PROJECT=""
#SENTRY_AUTH_TOKEN=""

# Development only
#ALLOW_LOCAL_TRAINING_URL=false
